---
import type { FeatureGridProps } from '@/contracts/content';
const { eyebrow, title, intro, items } = Astro.props as FeatureGridProps;
---

<section class="vb-section bg-[var(--vb-color-surface)]">
  <div class="vb-container">
    <div class="max-w-3xl">
      {eyebrow && <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-[var(--vb-color-accent)]">{eyebrow}</p>}
      <h2 class="text-3xl font-bold tracking-tight sm:text-5xl">{title}</h2>
      {intro && <p class="mt-5 text-lg leading-8 text-[var(--vb-color-muted)]">{intro}</p>}
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <article class="rounded-[var(--vb-radius-md)] bg-white p-6">
          <h3 class="text-xl font-semibold">{item.title}</h3>
          {item.text && <p class="mt-3 leading-7 text-[var(--vb-color-muted)]">{item.text}</p>}
        </article>
      ))}
    </div>
  </div>
</section>
