---
import ButtonLink from '@/components/ui/ButtonLink.astro';
import type { HeroProps } from '@/contracts/content';

const {
  eyebrow,
  title,
  intro,
  image,
  primaryCta,
  secondaryCta,
  variant = 'default',
} = Astro.props as HeroProps;
---

<section class="vb-section overflow-hidden">
  <div class:list={['vb-container grid items-center gap-10', variant === 'split' ? 'lg:grid-cols-2' : 'max-w-4xl']}>
    <div>
      {eyebrow && <p class="mb-4 text-sm font-semibold uppercase tracking-[0.14em] text-[var(--vb-color-accent)]">{eyebrow}</p>}
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-7xl">{title}</h1>
      {intro && <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--vb-color-muted)]">{intro}</p>}
      {(primaryCta || secondaryCta) && (
        <div class="mt-8 flex flex-wrap gap-3">
          {primaryCta && <ButtonLink {...primaryCta} />}
          {secondaryCta && <ButtonLink {...secondaryCta} variant="secondary" />}
        </div>
      )}
    </div>
    {image && (
      <div class="overflow-hidden rounded-[var(--vb-radius-lg)] bg-[var(--vb-color-surface)]">
        <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="eager" decoding="async" />
      </div>
    )}
  </div>
</section>
